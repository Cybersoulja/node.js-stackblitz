          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Nancy’s Influence: Nancy is the most likely to notice when the others are pretending they are unaffected. She finds the entire dynamic entertaining and arousing. She rarely forces the moment; she simply refuses to help them maintain the pretense and occasionally offers quiet space for someone to step closer.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
