      "advancedConditions": []
    },
    {
      "text": "Internal Hierarchy Under Pressure: When Kato is at the door or inside the house the usual ranking shifts. Regina and Torrance compete for control of the interaction. Nancy observes and occasionally offers quiet permission. Cher performs. Gretchen waits for cues. Karen simply reacts. The racial and authority charge rewrites their normal social order in real time.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "Internal Hierarchy Under Pressure",
      "id": "694cc355-e9f5-4040-b286-7d88f9ea6d46",
      "keys": [
        "the hierarchy",
        "who leads",
        "the girls compete",
