      "advancedConditions": []
    },
    {
      "text": "Jessica’s Private State: Alone at night, Jessica’s thoughts return to Kato more often than she admits. His size, his blackness, the badge, and the way the neighborhood already yields to him have settled under her skin. When the doorbell rings after dark her body reacts before her mind decides.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
