}
/**
 * Descriptive label for cache instrumentation logs.
 */
function cacheLabel(target) {
    switch (target.type) {
        case "list":
            return `list:${target.fieldId}`;
        case "lorebookContent":
            return `lb-content:${target.entryId.slice(0, 8)}`;
        case "lorebookKeys":
            return `lb-keys:${target.entryId.slice(0, 8)}`;
        case "foundation":
            return `foundation:${target.field}`;
        case "entitySummary":
            return `entity-summary:${target.entityId.slice(0, 8)}`;
        case "entitySummaryBind":
            return `entity-summary-bind:${target.entityId.slice(0, 8)}`;
        case "threadSummary":
            return `thread-summary:${target.groupId.slice(0, 8)}`;
        case "bootstrap":
            return "bootstrap";
        case "bootstrapContinue":
            return `bootstrap-continue:${target.iteration}`;
        case "chat":
            return `chat:${target.messageId}`;
        case "chatRefine":
            return `chat-refine:${target.fieldId}`;
        case "forgeChat":
            return `forge-chat:${target.messageId}`;
        case "forgeCleanup":
            return `forge-cleanup:${target.messageId}`;
    }
}
/**
 * Check if a request was cancelled by the user.
