                    return {
                        kind: "REVISE",
                        status: "rejected",
                        name: cmd.name,
                        reason: "live entity",
                    };
                }
                dispatch(entitySummaryUpdated({
                    entityId: target.id,
                    summary: cmd.content,
                    lastAffectingMessageId: assistantMessageId,
