          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Helen Park’s Awareness: Helen notices Kato’s size and presence with a calm that borders on fascination. She does not rush or perform. When he is in her doorway the years of careful self-control begin to loosen. She is the slower burn of the neighborhood, but the heat is real and accumulating.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
