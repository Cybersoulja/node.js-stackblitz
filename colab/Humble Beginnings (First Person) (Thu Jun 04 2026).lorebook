    {
      "text": "Gold coins were the currency of Cromus. Regular sundries cost only a few gold coins, while expensive jewelry could cost hundreds of coins.",
      "contextConfig": {
        "prefix": "[ ",
        "suffix": " ]\n",
        "tokenBudget": 1,
        "reservedTokens": 1,
        "budgetPriority": -200,
        "trimDirection": "trimBottom",
