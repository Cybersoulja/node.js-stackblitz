          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Carolyn Price, early fifties, HOA board member, keeps the neighborhood ‘nice’. Outwardly proper and slightly condescending until Kato is standing in her doorway. Then the authority of the badge and the physical reality of him override her usual social power. She becomes careful and accommodating.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
