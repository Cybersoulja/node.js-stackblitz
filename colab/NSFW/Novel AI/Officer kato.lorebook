        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Tran House: Michael and Emily Tran, early thirties. Emily is white; Michael is Asian-American. They keep a low profile. Emily is the one who feels the Shift more strongly. Michael notices the change in her attention when Kato is mentioned or nearby and has begun to go quieter in those moments.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
