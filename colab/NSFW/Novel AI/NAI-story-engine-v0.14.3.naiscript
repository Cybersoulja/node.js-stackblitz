        let pending = null;
        const arm = () => {
            void api.v1.timers
                .setTimeout(() => {
                if (stopped)
                    return;
                pending = null;
                setTick((n) => n + 1);
                arm();
            }, delayMs)
                .then((id) => {
                // The creation promise can resolve after cleanup ran; clear it if so.
                if (stopped)
