          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Shared Private Knowledge: Several of the sisters have already had individual moments or near-moments with Kato that the full group does not know about. The gap between what is shared and what is kept private creates its own tension inside the house. The Shift moves both openly and in secret here.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
