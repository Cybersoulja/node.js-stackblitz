          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Rachel Stein, 37, dark hair, sharp features, works part-time from home. One of the few who tries to meet Kato’s gaze and hold it. The attempt never lasts long. She is intelligent enough to recognize the dynamic and still finds herself responding to it.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
