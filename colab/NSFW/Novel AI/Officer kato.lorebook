      ],
      "advancedConditions": []
    },
    {
      "text": "Daniel Harlan, Jessica’s husband. Mid-thirties, successful, often away on business. When home he is polite and careful around Kato. He senses the undercurrent but prefers not to name it. His absence is more useful to Kato than his presence.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
