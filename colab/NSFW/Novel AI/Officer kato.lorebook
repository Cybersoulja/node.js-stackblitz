          "phrases": [],
          "ensureSequenceFinish": false,
          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Whitfield House: Megan keeps a sharper surface than most. She is quick with words and still tries to maintain the old social balance. Brad senses the change in how she looks at Kato but has no language for it that does not make him feel smaller.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "The Whitfield House",
      "id": "34266d78-d4e0-4926-bf09-70dba2f031f6",
      "keys": [
        "Whitfield house",
        "the Whitfield house",
        "Megan’s house",
        "Whitfield home"
      ],
      "searchRange": 1500,
      "enabled": true,
      "forceActivation": false,
      "keyRelative": false,
      "nonStoryActivatable": false,
      "category": "",
      "loreBiasGroups": [
        {
          "phrases": [],
          "ensureSequenceFinish": false,
          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Megan’s Resistance Pattern: Her first response is almost always verbal control—questions, boundaries, polite firmness. Once Kato is inside, the physical reality of him begins to override her script. She notices it happening and still cannot fully stop it.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "Megan’s Resistance Pattern",
      "id": "6edfd837-70d1-4767-8c11-0bf5fe60b006",
      "keys": [
        "Megan’s resistance",
        "Megan talks",
        "Megan tries to control",
        "Megan softens"
      ],
      "searchRange": 1500,
