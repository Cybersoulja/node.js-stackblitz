          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "After He Leaves: Once Kato’s cruiser pulls away the house does not immediately return to normal. Comments are made. Looks are exchanged. Some girls go quiet; others laugh too loudly. The conversation that follows is rarely fully honest, but the charge remains in the rooms for hours.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
