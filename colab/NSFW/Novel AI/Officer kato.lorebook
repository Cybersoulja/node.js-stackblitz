          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Rachel’s Conscious Surrender: Rachel is one of the few who can name what is happening while it is happening. She meets Kato’s eyes, recognizes the imbalance, and still feels the pull. Her eventual yielding carries extra weight because she is not pretending she does not understand.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
