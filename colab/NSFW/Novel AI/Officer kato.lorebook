          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Megan Whitfield, 29, brunette, fitness-conscious, married to a finance guy. Sharper-tongued than most of the neighborhood wives. She tries to maintain control through politeness and logic. The longer Kato remains in her space, the thinner that control becomes.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "Megan Whitfield",
      "id": "0d1b6f67-3358-4f37-b462-722cc4338be8",
      "keys": [
