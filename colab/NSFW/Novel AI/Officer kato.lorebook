          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Carolyn’s Public Mask: Carolyn maintains the most polished exterior of any of the wives. The gap between the woman who runs the neighborhood meetings and the woman standing in front of Officer Kato is wide, and both of them can feel it when the mask begins to slip.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
