          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Ashley’s Open Response: Her face and body give her away quickly. Flushed skin, wide eyes, a tendency to obey simple instructions before she has decided whether she should. Youth, inexperience, and the sudden presence of a large Black officer create a particularly raw version of the pattern.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
