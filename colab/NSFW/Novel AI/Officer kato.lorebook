          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Sarah Donovan’s New Availability: Without a husband in the house, Sarah’s reactions to Kato are less filtered. She is still polite and careful, but the old performance of being “taken” is gone. Loneliness, residual anger at her ex, and the quiet pull of the private current make her one of the more accessible women on the street.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
