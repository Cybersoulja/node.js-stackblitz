            messages,
            params: await buildModelParams({
                max_tokens: 1024,
                temperature: 0.85,
                min_p: 0.05,
                frequency_penalty: 0.1,
                stop: LOREBOOK_CHAIN_STOPS,
            }),
            contextPinning: { head: 1, tail: xialong ? 5 : 4 },
        };
    };
};
/**
