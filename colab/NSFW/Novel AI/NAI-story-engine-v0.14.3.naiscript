// ─────────────────────────────────────────────────────────────────────────────
// Registration
// ─────────────────────────────────────────────────────────────────────────────
function registerGenerationEngineEffects(subscribeEffect, dispatch, getState, genX) {
    // Intent: GenX Generation (using handler map pattern)
