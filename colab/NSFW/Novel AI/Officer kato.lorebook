          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Price House: The most publicly proper home on the street. HOA standards, careful appearances, a reputation for keeping the neighborhood “nice.” Authority that works at the neighborhood meetings does not automatically work once Kato is standing in her foyer.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
