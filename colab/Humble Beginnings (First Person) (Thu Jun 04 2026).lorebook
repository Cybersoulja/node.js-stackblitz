{
  "lorebookVersion": 6,
  "entries": [
    {
      "text": "Anser was a small rural village in the kingdom of Cromus, where I was born and raised. I sought to leave Anser in search of adventure.",
      "contextConfig": {
        "prefix": "[ ",
        "suffix": " ]\n",
        "tokenBudget": 1,
        "reservedTokens": 1,
        "budgetPriority": -200,
        "trimDirection": "trimBottom",
