          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Lauren Crowe, 41, elegant, well-kept, two teenage kids who are rarely home. She has a quiet, almost resigned awareness of Kato’s reputation. She does not pretend she doesn’t notice his size or the badge. Her yielding tends to be silent and physical rather than verbal.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "Lauren Crowe",
      "id": "adb0b1b1-6108-4698-b0ac-554a698046b0",
      "keys": [
