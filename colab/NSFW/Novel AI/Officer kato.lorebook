      ],
      "advancedConditions": []
    },
    {
      "text": "The Brennan House: Mark and Ruth Brennan, early forties. Active in the local church, publicly moral, carefully presented. Their home is one of the last places in the neighborhood that still tries to hold the old rules. The Shift has begun testing that. Ruth’s politeness around Kato has a brittle quality. Mark’s authority inside the marriage is quieter than he wants to admit.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
