      "id": "d7cafe1b-7153-4e9e-b066-4801ea69aa7f",
      "keys": [
        "Houston Hustlers"
      ],
      "searchRange": 1000,
      "enabled": true,
      "forceActivation": false,
      "keyRelative": false,
      "nonStoryActivatable": false,
      "category": "0780f31f-650a-4f78-84fa-f403b6bdd661",
