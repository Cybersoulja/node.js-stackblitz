    },
    {
      "text": "The Ninjas are an elite military force trained in stealth and espionage. They serve as the personal guard of the Shogun and are tasked with protecting him from any threats. Their skills are such that they can sneak into even the most heavily guarded fortresses without being detected, and they're known to be able to kill a man with a single blow.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
