          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Brad Whitfield, Megan’s husband. Finance, late thirties, tries to project confidence. Around Kato he becomes quieter and more formal. He does not like how his wife looks at the officer and has no good way to address it without looking weak.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
