    },
    {
      "text": "Cromus was a kingdom ruled by the benevolent King Cromus XI. The opulent Cromus Castle was located in the capital city.",
      "contextConfig": {
        "prefix": "[ ",
        "suffix": " ]\n",
        "tokenBudget": 1,
        "reservedTokens": 1,
        "budgetPriority": -200,
