          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Crowe House: Quieter and more controlled on the surface. Two teenage children often away, a husband who keeps long hours. Lauren has watched the neighborhood change with a more adult, almost fatalistic understanding. She does not pretend the current is not real.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
