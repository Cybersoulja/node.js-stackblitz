/*---
compatibilityVersion: naiscript-1.0
id: e6c35faa-e4f2-4c3b-af4a-d56e4c992d87
name: Story Engine
version: 0.14.3
createdAt: 1765374901
author: Keilla
description: A helper for writing stories
memoryLimit: 8
updatedAt: 1789092134
config:
  - name: xialong_mode
    prettyName: Xialong Mode
    description: >-
      Use Xialong v1 for all generation. Requires an Opus subscription. When
      disabled, all generation uses GLM 4.6.
    type: boolean
    default: false
  - name: sega_skip_lorebook_keys
    prettyName: Skip Lorebook Keys (SEGA)
    description: >-
      When enabled, SEGA will skip automatic lorebook key generation after
      generating entry content. Useful if you prefer to set keys manually.
    type: boolean
    default: false
  - name: sega_skip_lorebook_relational_map
    prettyName: Skip Lorebook Relational Map (SEGA)
    description: >-
      When enabled, SEGA will skip the relational map pass and generate keys
      directly from entry prose. Keys quality may be lower for generic-named
      entries without this cross-entry context pass.
    type: boolean
    default: false
  - name: generation_journal
    prettyName: Generation Journal
    description: >-
      Enables the Generation Journal panel, which records all prompts and
      responses sent during generation. Use "Copy Journal" to paste into Claude
      for quality review.
    type: boolean
    default: false
  - name: erato_compatibility
    prettyName: Erato Compatibility
    description: >-
      For use with Erato. Moves the lorebook entry separator (----) from the
      category header (unsupported by Erato) into each entry's text content.
      Also creates a forced-activation "SE: End of Lorebook" marker entry
      containing *** to separate lorebook from story text. You MUST manually set
      that entry's position to 1 (the API cannot set this). On toggle, all
      managed lorebook entries are automatically migrated.
    type: boolean
    default: false
  - name: story_engine_debug
    prettyName: Story Engine Debug
    description: Enable debug logging for Story Engine
    type: boolean
    default: false
---*/

/**
 * Story Engine
 * Built with NovelAI Script Build System
 */

/*
 NAIStore - [0.2.0]
*/
// ==================================================
// createStore
// ==================================================
function createStore(reducer, debug = false) {
    // Initialize state by dispatching the init action.
    let currentState = reducer(undefined, { type: "@@NAISTORE/INIT" });
    const listeners = new Set();
    const effects = new Set();
    let dispatchDepth = 0;
    let _batching = false;
    let _batchedActions = [];
    function getState() {
        return currentState;
    }
    function dispatch(action) {
        if (dispatchDepth > 10) {
            api.v1.log("[NAISTORE] Dispatch cascade depth > 10, dropping action:", action.type);
            return;
        }
        dispatchDepth++;
        try {
            if (debug)
                api.v1.log("NAISTORE", action);
            currentState = reducer(currentState, action);
            if (_batching) {
                _batchedActions.push(action);
                return;
            }
            for (const l of listeners) {
                l(currentState);
            }
            const ctx = { dispatch, getState };
            for (const e of effects) {
                if (e.when(action))
                    e.run(action, ctx);
            }
        }
        finally {
            dispatchDepth--;
        }
    }
    function batch(fn) {
        if (_batching) {
            // Nested batch — just run; the outer batch handles notifications
            fn();
            return;
        }
        _batching = true;
        _batchedActions = [];
        try {
            fn();
        }
        finally {
            _batching = false;
            const actions = _batchedActions;
            _batchedActions = [];
            // Notify listeners once with the final state
            for (const l of listeners) {
                l(currentState);
            }
            // Run effects for each batched action
            const ctx = { dispatch, getState };
            for (const action of actions) {
                for (const e of effects) {
                    if (e.when(action))
                        e.run(action, ctx);
                }
            }
        }
    }
    function subscribe(listener) {
        listeners.add(listener);
        return () => {
            listeners.delete(listener);
        };
    }
    function subscribeSelector(selector, listener, equals = Object.is) {
        let current = selector(currentState);
        return subscribe((state) => {
            const next = selector(state);
            if (equals(next, current))
                return;
            current = next;
            listener(next);
        });
    }
    function subscribeEffect(when, run) {
        const effect = { when, run };
        effects.add(effect);
        return () => {
            effects.delete(effect);
        };
    }
    return {
        getState,
        dispatch,
        batch,
        subscribeSelector,
        subscribeEffect,
    };
}
/**
 * Creates a slice of state with auto-generated actions and reducer.
 */
function createSlice(options) {
    const { name, initialState, reducers } = options;
    const actions = {};
    const handlers = {};
    for (const key of Object.keys(reducers)) {
        const actionType = `${name}/${key}`;
        handlers[actionType] = reducers[key];
        const creator = (payload) => ({ type: actionType, payload });
        creator.type = actionType;
        // @ts-ignore: Dynamic action creator assignment
        actions[key] = creator;
    }
    const reducer = (state, action) => {
        if (state === undefined)
            return initialState;
        const handler = handlers[action.type];
        if (handler) {
            return handler(state, action.payload);
        }
        return state;
    };
    return { reducer, actions };
}
/**
 * Combines multiple slice reducers into a single root reducer.
 */
function combineReducers(reducers) {
    return function combinedReducer(state, action) {
        let changed = false;
        const nextState = {};
        for (const key in reducers) {
            const prevSlice = state ? state[key] : undefined;
            const nextSlice = reducers[key](prevSlice, action);
            nextState[key] = nextSlice;
            if (!state || nextSlice !== prevSlice)
                changed = true;
        }
        return changed ? nextState : state;
    };
}
// ==================================================
// Effect Helpers
// ==================================================
/**
 * Type-safe action matcher for use with subscribeEffect.
 * Extracts the action type string from an action creator.
 *
 * @example
 * subscribeEffect(
 *   matchesAction(myAction),
 *   (action, ctx) => {
 *     // action.payload is properly typed
 *   }
 * );
 */
function matchesAction(actionCreator, payloadPredicate) {
    const actionType = actionCreator.type;
    return (action) => action.type === actionType &&
        (!payloadPredicate || payloadPredicate(action.payload));
}
/*
 * END NAIStore
 */

function makeDefaultBrainstorm() {
    return {
        id: api.v1.uuid(),
        type: "brainstorm",
        title: "Brainstorm 1",
        subMode: "cowriter",
        messages: [],
        seed: { kind: "blank" },
    };
}
const seedChat = makeDefaultBrainstorm();
const initialChatState = {
    chats: [seedChat],
    activeChatId: seedChat.id,
};
function mapChat(state, id, fn) {
    return { ...state, chats: state.chats.map((c) => (c.id === id ? fn(c) : c)) };
}
const chatSlice = createSlice({
    name: "chat",
    initialState: initialChatState,
    reducers: {
        chatCreated: (state, payload) => ({
            ...state,
            chats: [...state.chats, payload.chat],
            activeChatId: payload.chat.id,
        }),
        chatRenamed: (state, payload) => mapChat(state, payload.id, (c) => ({ ...c, title: payload.title })),
        chatSwitched: (state, payload) => {
            if (!state.chats.some((c) => c.id === payload.id))
                return state;
            return { ...state, activeChatId: payload.id };
        },
        chatDeleted: (state, payload) => {
            if (state.chats.length <= 1)
                return state;
            const chats = state.chats.filter((c) => c.id !== payload.id);
            const activeChatId = state.activeChatId === payload.id
                ? chats[chats.length - 1].id
                : state.activeChatId;
            return { ...state, chats, activeChatId };
        },
        subModeChanged: (state, payload) => mapChat(state, payload.id, (c) => ({ ...c, subMode: payload.subMode })),
        messageAdded: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: [...c.messages, payload.message],
        })),
        messageUpdated: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: c.messages.map((m) => m.id === payload.id ? { ...m, content: payload.content } : m),
        })),
        messageAppended: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: c.messages.map((m) => m.id === payload.id
                ? { ...m, content: m.content + payload.content }
                : m),
        })),
        messageRemoved: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: c.messages.filter((m) => m.id !== payload.id),
        })),
        forgeSegmentsSet: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: c.messages.map((m) => m.id === payload.id ? { ...m, forgeSegments: payload.segments } : m),
        })),
        messagesPrunedAfter: (state, payload) => mapChat(state, payload.chatId, (c) => {
            const idx = c.messages.findIndex((m) => m.id === payload.id);
            if (idx === -1)
                return c;
            const target = c.messages[idx];
            const cut = target.role === "user" ? idx + 1 : idx;
            return { ...c, messages: c.messages.slice(0, cut) };
        }),
        refineCandidateMarked: (state, payload) => mapChat(state, payload.chatId, (c) => ({
            ...c,
            messages: c.messages.map((m) => m.id === payload.messageId ? { ...m, refineCandidate: true } : m),
        })),
    },
});
const { chatCreated, chatRenamed, chatSwitched, chatDeleted, subModeChanged, messageAdded, messageUpdated, messageAppended, messageRemoved, forgeSegmentsSet, messagesPrunedAfter, refineCandidateMarked, } = chatSlice.actions;
function activeSavedChat(state) {
    if (!state.activeChatId)
        return null;
    return state.chats.find((c) => c.id === state.activeChatId) ?? null;
}

const initialLorebookState = {
    selectedEntryId: null,
    selectedCategoryId: null,
};
const initialUIState = {
    activeEditId: null,
    inputs: {},
    lorebook: initialLorebookState,
    worldExpanded: null,
    importWizardOpen: false,
};
const uiSlice = createSlice({
    name: "ui",
    initialState: initialUIState,
    reducers: {
        uiInputChanged: (state, payload) => ({
            ...state,
            inputs: {
                ...state.inputs,
                [payload.id]: payload.value,
            },
        }),
        // Intents (handled by Effects)
        uiRequestCancellation: (state) => state,
        uiUserPresenceConfirmed: (state) => state,
        // Chat user intents
        // `text` travels in the payload, NOT via a shared storyStorage slot: the
        // effect's read is async, so two sends in flight at once would both read
        // whatever the last one wrote (see ChatInput's duplicate-tap note).
        uiChatSubmitUserMessage: (state, _payload) => state,
        uiChatRetryGeneration: (state, _payload) => state,
        uiChatSummarizeRequested: (state, _payload) => state,
        uiChatRefineRequested: (state, _payload) => state,
        // Run a refine generation turn (rewrite or fresh-generate, decided by the
        // strategy from the seeded-context presence) — fired by the refine send and
        // the refine Clear/onClear hook.
        uiChatRefineGenerateRequested: (state, _payload) => state,
        uiChatRefineCommitted: (state, _payload) => state,
        uiChatRefineDiscarded: (state, _payload) => state,
        // Internal: Submit generation to GenX (not a user intent)
        generationSubmitted: (state, _strategy) => state,
        uiCancelRequest: (state, _payload) => state,
        // Editable singleton — at most one editor active at a time. `id` is an
        // entity id, a world group id, or a Foundation field id ("shape", "intent",
        // …); StoryEngine routes the open pane by membership.
        uiEditableActivate: (state, payload) => ({
            ...state,
            activeEditId: payload.id,
        }),
        uiEditableDeactivate: (state) => ({
            ...state,
            activeEditId: null,
        }),
        // Lorebook user intents (handled by effects)
        uiLorebookEntrySelected: (state, payload) => ({
            ...state,
            lorebook: {
                ...state.lorebook,
                selectedEntryId: payload.entryId,
                selectedCategoryId: payload.categoryId,
            },
        }),
        uiLorebookContentGenerationRequested: (state, _payload) => state,
        uiLorebookKeysGenerationRequested: (state, _payload) => state,
        // Item-level lorebook generation (queues both content + keys)
        uiLorebookItemGenerationRequested: (state, _payload) => state,
        // World expand/collapse all
        worldExpansionSet: (state, payload) => ({
            ...state,
            worldExpanded: payload.expanded,
        }),
        // Import wizard visibility (shown over the Story Engine tab)
        importWizardOpened: (state) => ({ ...state, importWizardOpen: true }),
        importWizardClosed: (state) => ({ ...state, importWizardOpen: false }),
        // Summary generation intents
        uiEntitySummaryGenerationRequested: (state, _payload) => state,
        uiThreadSummaryGenerationRequested: (state, _payload) => state,
    },
});
const { worldExpansionSet, importWizardOpened, importWizardClosed, uiRequestCancellation, uiUserPresenceConfirmed, uiChatSubmitUserMessage, uiChatRetryGeneration, uiChatSummarizeRequested, uiChatRefineRequested, uiChatRefineGenerateRequested, uiChatRefineCommitted, uiChatRefineDiscarded, generationSubmitted, uiCancelRequest, uiEditableActivate, uiEditableDeactivate, uiLorebookEntrySelected, uiLorebookContentGenerationRequested, uiLorebookKeysGenerationRequested, uiLorebookItemGenerationRequested, uiEntitySummaryGenerationRequested, uiThreadSummaryGenerationRequested, } = uiSlice.actions;

const initialSegaState = {
    stage: "idle",
    statusText: "",
    activeRequestIds: [],
    keysCompleted: {},
};
const initialRuntimeState = {
    segaRunning: false,
    sega: initialSegaState,
    queue: [],
    activeRequest: null,
    status: "idle",
    budgetTimeRemaining: 0,
    genx: {
        status: "idle",
        queueLength: 0,
    },
    historyEpoch: 0,
};
const runtimeSlice = createSlice({
    name: "runtime",
    initialState: initialRuntimeState,
    reducers: {
        stateUpdated: (state, payload) => ({
            ...state,
            genx: payload.genxState,
        }),
        segaToggled: (state) => ({
            ...state,
            segaRunning: !state.segaRunning,
        }),
        // Just adds to queue (no effect, for when strategy is already built)
        requestQueued: (state, request) => ({
            ...state,
            queue: [...state.queue, { ...request, status: "queued" }],
            status: state.status === "idle" ? "queued" : state.status,
        }),
        requestActivated: (state, payload) => {
            const idx = state.queue.findIndex((r) => r.id === payload.requestId);
            if (idx === -1)
                return state;
            const activated = state.queue[idx];
            return {
                ...state,
                queue: state.queue.filter((r) => r.id !== payload.requestId),
                activeRequest: { ...activated, status: "processing" },
                status: "generating",
            };
        },
        queueCleared: (state) => ({
            ...state,
            queue: [],
            activeRequest: null,
            status: "idle",
        }),
        budgetUpdated: (state, payload) => ({
            ...state,
            budgetTimeRemaining: payload.timeRemaining,
        }),
        // Mark a request as cancelled (status change on the request itself)
        requestCancelled: (state, payload) => {
            // Check if in queue
            const queueIndex = state.queue.findIndex((r) => r.id === payload.requestId);
            if (queueIndex >= 0) {
                const newQueue = [...state.queue];
                newQueue[queueIndex] = { ...newQueue[queueIndex], status: "cancelled" };
                return { ...state, queue: newQueue };
            }
            // Check if active request
            if (state.activeRequest?.id === payload.requestId) {
                return {
                    ...state,
                    activeRequest: { ...state.activeRequest, status: "cancelled" },
                };
            }
            return state;
        },
        // Mark a request as completed and clear from active/queue
        requestCompleted: (state, payload) => {
            const isActive = state.activeRequest?.id === payload.requestId;
            const newQueue = state.queue.filter((r) => r.id !== payload.requestId);
            if (!isActive && newQueue.length === state.queue.length) {
                return state;
            }
            return {
                ...state,
                activeRequest: isActive ? null : state.activeRequest,
                queue: newQueue,
            };
        },
        // SEGA Reducers
        segaStageSet: (state, payload) => ({
            ...state,
            sega: { ...state.sega, stage: payload.stage },
        }),
        segaRequestTracked: (state, payload) => ({
            ...state,
            sega: {
                ...state.sega,
                activeRequestIds: [...state.sega.activeRequestIds, payload.requestId],
            },
        }),
        segaRequestUntracked: (state, payload) => ({
            ...state,
            sega: {
                ...state.sega,
                activeRequestIds: state.sega.activeRequestIds.filter((id) => id !== payload.requestId),
            },
        }),
        // Batch untrack multiple SEGA request IDs in one dispatch
        segaBulkUntracked: (state, payload) => {
            const removeSet = new Set(payload.requestIds);
            return {
                ...state,
                sega: {
                    ...state.sega,
                    activeRequestIds: state.sega.activeRequestIds.filter((id) => !removeSet.has(id)),
                },
            };
        },
        // Batch complete multiple requests in one dispatch
        requestsBulkCompleted: (state, payload) => {
            const removeSet = new Set(payload.requestIds);
            const isActive = state.activeRequest !== null && removeSet.has(state.activeRequest.id);
            const newQueue = state.queue.filter((r) => !removeSet.has(r.id));
            if (!isActive && newQueue.length === state.queue.length)
                return state;
            return {
                ...state,
                activeRequest: isActive ? null : state.activeRequest,
                queue: newQueue,
            };
        },
        segaReset: (state) => ({
            ...state,
            sega: initialSegaState,
        }),
        segaStatusUpdated: (state, payload) => ({
            ...state,
            sega: { ...state.sega, statusText: payload.statusText },
        }),
        segaKeysCompleted: (state, payload) => ({
            ...state,
            sega: {
                ...state.sega,
                keysCompleted: {
                    ...state.sega.keysCompleted,
                    [payload.entryId]: true,
                },
            },
        }),
        // `guidance` is the writer's free-text answer to "Open the story with:" —
        // empty string when they generated without typing anything.
        bootstrapRequested: (state, _payload) => state,
        bootstrapContinueRequested: (state) => state,
        documentHistoryNavigated: (state) => ({
            ...state,
            historyEpoch: state.historyEpoch + 1,
        }),
    },
});
const { stateUpdated, segaToggled, requestQueued, requestActivated, queueCleared, requestCancelled, requestCompleted, segaStageSet, segaRequestTracked, segaRequestUntracked, segaBulkUntracked, requestsBulkCompleted, segaReset, segaStatusUpdated, segaKeysCompleted, bootstrapRequested, bootstrapContinueRequested, documentHistoryNavigated, } = runtimeSlice.actions;

