      ],
      "advancedConditions": []
    },
    {
      "text": "Claire’s Quiet Hunger: Claire does not perform or flirt. When Kato is at her door the silence between them carries weight. She is not shocked by the private current the way some of the younger wives are. Something in her has already been hollowed out and is waiting to be filled by a stronger presence.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
