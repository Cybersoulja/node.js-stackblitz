          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Voss House: Ashley is the youngest of the regularly watched wives and the least practiced at hiding her reactions. The marriage is still new. The Shift has hit her harder and faster than the older women. Her curiosity is more open, her fear more visible.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
