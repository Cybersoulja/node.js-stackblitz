            {
                role: "user",
                content: `ENTRY:\n\n${contextContent}`,
            },
        ];
        await appendXialongStyleMessage(messages, XIALONG_STYLE.lorebookKeys);
        messages.push({ role: "assistant", content: `REJECTED:\n` });
