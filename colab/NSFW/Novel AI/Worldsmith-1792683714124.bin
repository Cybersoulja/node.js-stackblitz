// Worldsmith Lore Generator v0.1.1
// Import-ready NovelAI user script. No external dependencies.
//
// Design:
//   world model -> procedural generators -> NovelAI lorebook adapter -> UI
//
// v0.1 intentionally does not create Lorebook categories because the minimal
// createEntry API is enough for a reliable first version. Categories can be
// added once we decide how generated worlds should be organized.

// -----------------------------------------------------------------------------
// Data pools
// -----------------------------------------------------------------------------

const WS_DATA = {
  worldAdjectives: [
    "Shattered", "Silver", "Ashen", "Hollow", "Crimson", "Forgotten",
    "Gilded", "Veiled", "Stormbound", "Obsidian", "Whispering", "Last"
