            // name key first and adds the model's map-informed keys around it.
            const lorebookEntry = await api.v1.lorebook.entry(entryId);
            await api.v1.lorebook.updateEntry(entryId, {
                keys: [nameKey(lorebookEntry?.displayName || "")],
