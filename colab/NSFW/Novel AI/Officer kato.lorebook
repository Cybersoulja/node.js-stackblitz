        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Ellison House: Claire Ellison, 33, widowed two years ago. Quiet house, carefully maintained. She keeps to herself more than most. The neighborhood still treats her with a certain careful distance. Kato’s presence cuts through that distance. She has the look of a woman who has already lost something and is not sure what she is allowed to want next.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
