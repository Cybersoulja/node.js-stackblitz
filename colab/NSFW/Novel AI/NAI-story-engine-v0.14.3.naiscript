async function captureRollbackState(target) {
    if (target.type !== "lorebookContent" && target.type !== "lorebookKeys") {
        return { content: "", keys: "" };
    }
    const entry = await api.v1.lorebook.entry(target.entryId);
    return {
        content: entry?.text || "",
        keys: entry?.keys?.join(", ") || "",
