          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Ashley Voss, 26, newly married, still adjusting to the neighborhood. The most openly affected by Kato’s presence—wide-eyed, flushed, and quick to obey simple instructions. Her husband is younger and less established; she is already more afraid of Kato than of him.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
