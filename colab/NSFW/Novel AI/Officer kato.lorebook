          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Lauren’s Quiet Yielding: Lauren rarely argues at length. When Kato is in her doorway or inside her house, her body language becomes the main signal. She holds his gaze longer than most, then looks away. Compliance, when it comes, is silent.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
