          "generateOnce": true,
          "bias": 0,
          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "The Stein House: Rachel is sharper and more self-aware than most. She understands the racial and power current moving through the neighborhood and still finds herself answering it. Her intelligence does not protect her; it only makes her more conscious of the moment the old rules stop working.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
