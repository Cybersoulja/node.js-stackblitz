          "enabled": true,
          "whenInactive": false
        }
      ],
      "advancedConditions": []
    },
    {
      "text": "Regina vs. Kato: Regina’s usual weapons—social status, beauty, verbal sharpness—do not land the same way on Kato. Each attempt to reassert control makes the power imbalance more visible. The fracture is progressive. The other girls watch closely as her footing shifts.",
      "contextConfig": {
        "prefix": "",
        "suffix": "\n",
        "tokenBudget": 1,
        "reservedTokens": 0,
        "budgetPriority": 400,
        "trimDirection": "trimBottom",
        "insertionType": "newline",
        "maximumTrimType": "sentence",
        "insertionPosition": -1
      },
      "lastUpdatedAt": 1792134039152,
      "displayName": "Regina vs. Kato",
      "id": "a3f2aeea-563c-4e91-94d9-ee2d44dd31d6",
      "keys": [
        "Regina and Kato",
        "Regina tries to control",
        "Regina loses ground",
        "the queen bee breaks"
      ],
      "searchRange": 1500,
